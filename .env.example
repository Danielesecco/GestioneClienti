# Prendi questi due valori da Supabase:
# Project Settings > API (o "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SOLO per creare nuovi operatori dall'app (route server-side).
# Da Supabase: Project Settings > API Keys > "service_role" (o "secret").
# NON deve MAI avere il prefisso NEXT_PUBLIC_ e non va mai esposta
# nel codice del browser: va aggiunta SOLO nelle Environment
# Variables di Vercel, non serve nel .env.local se non sviluppi
# in locale la sezione operatori.
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
